{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mxdownloader-api",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-09-26",
  "containers": [
    {
      "class_name": "MxDownloaderContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MX_BACKEND",
        "class_name": "MxDownloaderContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MxDownloaderContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
